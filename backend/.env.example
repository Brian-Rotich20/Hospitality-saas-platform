# LinkMart backend configuration. Copy to .env for local development.
# NEVER commit real values. In staging/production, set these in the platform's secret store.
# The process refuses to start if a required value is missing or malformed.

# ── Application ───────────────────────────────────────────────────────────────
# Required. One of: development | test | production. There is no default on purpose.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public base URL of THIS API (used to build M-Pesa callback URLs). Must be HTTPS in production.
API_PUBLIC_URL=http://localhost:3000
# Frontend base URL (links in emails, including password-reset links).
FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS and trusted by Better Auth (origin and
# callbackURL checks). Must include the public frontend origin.
CORS_ORIGINS=http://localhost:5173
# Serve OpenAPI docs at /docs. Keep false in production.
SWAGGER_ENABLED=false
RATE_LIMIT_ENABLED=true
# Which proxies may set X-Forwarded-For (used for anonymous rate limits, session IPs and
# the Daraja IP allow-list). Signed-in users are always rate-limited by account, not IP.
#   false            ignore forwarded headers; use the TCP peer address (default, direct exposure)
#   1..5             trust exactly that many proxy hops in front of the API
#   10.0.0.0/8,...   trust forwarded headers only from these proxy addresses / CIDRs (preferred)
# `true` (trust anything) is rejected at startup. A hop count is only safe if the API cannot be
# reached except through those proxies; otherwise a direct caller can forge its address.
# See docs/operations/RUNBOOK.md ("Proxy, client IPs and rate limits").
TRUST_PROXY=false
# At least 32 random characters (e.g. `openssl rand -hex 32`).
COOKIE_SECRET=

# ── Database (PostgreSQL 15+; btree_gist extension must be creatable) ──────────
DATABASE_URL=postgresql://linkmart:linkmart@localhost:5432/linkmart
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ── Redis (cache, rate limits, BullMQ queues) ─────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TIMEOUT_MS=250
# Namespace for BullMQ keys; use a different value per environment sharing a Redis.
QUEUE_PREFIX=linkmart

# ── Better Auth ───────────────────────────────────────────────────────────────
# At least 32 random characters. Rotating it signs every user out.
BETTER_AUTH_SECRET=
# Public origin where browsers reach /api/auth. The LinkMart frontend proxies /api/* to this
# API on its own origin, so this is the FRONTEND origin (Google redirect_uri and session
# cookies are issued for it), and it must also be listed in CORS_ORIGINS.
#   local:      BETTER_AUTH_URL=http://localhost:5173  (the Next.js dev server port you use)
#   production: BETTER_AUTH_URL=https://<your-frontend-domain>
# Google OAuth "Authorized redirect URI": {BETTER_AUTH_URL}/api/auth/callback/google
# Only if browsers call the API directly (no proxy) would this be the API origin.
BETTER_AUTH_URL=http://localhost:5173
# Optional Google sign-in. Both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage (public images only) ──────────────────────────────────────────────
# cloudinary | s3
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
# brevo (required in production) | memory (tests) | log (local dev: logs instead of sending)
MAIL_TRANSPORT=log
BREVO_API_KEY=
# Must be a sender verified in Brevo.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LinkMart

# ── Booking rules ─────────────────────────────────────────────────────────────
# Vendor response deadline (business rule: 24).
BOOKING_RESPONSE_HOURS=24
BOOKING_MAX_OPEN_REQUESTS_PER_CUSTOMER=5
# Accepted bookings become "completed" this many days after their end date (enables reviews).
BOOKING_AUTO_COMPLETE_DAYS=2
# Messaging stays open this many days after completion.
MESSAGING_OPEN_DAYS_AFTER_COMPLETION=30

# ── Vendor subscriptions ──────────────────────────────────────────────────────
# The PRICE is not configured here: an admin creates and activates a plan via
# POST /api/admin/subscriptions/plans. Until then, billing is held and vendors stay entitled.
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_EXPIRE_AFTER_SUSPENDED_DAYS=30
# Days before trial end to send reminders.
SUBSCRIPTION_TRIAL_REMINDER_DAYS=7,3,1
# Days after an invoice is due to send payment reminders.
SUBSCRIPTION_PAYMENT_REMINDER_DAYS=0,2,4,6
# Pending payments older than this are re-verified with the provider.
PAYMENT_PENDING_RECONCILE_MINUTES=10

# ── Paystack (vendor subscription payments ONLY) ──────────────────────────────
PAYSTACK_ENABLED=false
# Secret key (sk_test_... / sk_live_...). Also used to verify webhook signatures.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Where Paystack checkout redirects vendors after paying (a frontend page that then polls the API).
PAYSTACK_CALLBACK_URL=
# Saved-card renewals via charge_authorization. Only for vendors who opt in, and only with a
# reusable card authorization. Leave false until approved.
PAYSTACK_RECURRING_ENABLED=false
# Configure the webhook URL in the Paystack dashboard as: {API_PUBLIC_URL}/api/payments/paystack/webhook
# Handled events: charge.success (verified via /transaction/verify before crediting), refund.processed and
# charge.dispute.* (recorded and flagged for admin review; they never change a vendor's access automatically).

# ── Safaricom Daraja / M-Pesa Express (vendor subscription payments ONLY) ─────
DARAJA_ENABLED=false
# sandbox | production
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# Lipa Na M-Pesa shortcode (Paybill, or HO number for Buy Goods).
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# CustomerPayBillOnline (Paybill) | CustomerBuyGoodsOnline (Till)
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number when using Buy Goods; leave empty for Paybill.
DARAJA_PARTY_B=
# Random secret (24+ chars) embedded in the callback URL: {API_PUBLIC_URL}/api/payments/daraja/callback/{token}
# Daraja callbacks are unsigned; every callback is also confirmed with STK Query before crediting.
DARAJA_CALLBACK_TOKEN=
# Optional comma-separated allow-list of Safaricom callback source IPs (requires TRUST_PROXY behind a proxy).
DARAJA_ALLOWED_IPS=
